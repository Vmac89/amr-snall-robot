<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_base</name>
  <version>0.1.0</version>
  <description>CM4 bridge: cmd_vel to ESP32 DRIVE, encoder odometry and tf, optional libfreenect Kinect. Geometry parameters are uncalibrated placeholders.</description>
  <maintainer email="Vmac89@users.noreply.github.com">Vlatko Macak</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
