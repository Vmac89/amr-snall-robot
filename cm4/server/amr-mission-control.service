# Example unit for Raspberry Pi OS. Edit User, the repo path, and
# AMR_SERIAL_PORT before installing. The CM4 UART device node is still
# unset for this robot; /dev/ttyAMA0 is only the placeholder already used
# elsewhere in the repo.
#
#   sudo cp cm4/server/amr-mission-control.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now amr-mission-control.service
#
# AMR_ALLOW_POWEROFF stays 0 here. The shutdown button returns an error
# until that variable is set to 1. The process also needs permission to
# run `shutdown` before an armed request can succeed.
# /usr/bin/python3 needs flask, pyserial, and pillow (the Raspberry Pi OS
# packages python3-flask, python3-serial, and python3-pil, or a venv whose
# interpreter you put in ExecStart).

[Unit]
Description=AMR Mission Control HTTP server
After=network.target

[Service]
Type=simple
User=amr
SupplementaryGroups=dialout
WorkingDirectory=/opt/amr-snall-robot/cm4/server
ExecStart=/usr/bin/python3 /opt/amr-snall-robot/cm4/server/server.py
Environment=PYTHONUNBUFFERED=1
Environment=AMR_HOST=0.0.0.0
Environment=AMR_PORT=8080
Environment=AMR_SERIAL_PORT=/dev/ttyAMA0
Environment=AMR_SERIAL_BAUD=115200
Environment=AMR_MOCK_SERIAL=0
Environment=AMR_ALLOW_POWEROFF=0
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
